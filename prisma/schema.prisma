generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Marketplace {
  id     String  @id @default(uuid())
  titulo String
  vendas Venda[]

  @@map("marketplaces")
}

enum VendaStatus {
  PENDENTE
  PARCIALMENTE_PAGO
  PAGO
  CANCELADO
}

model Venda {
  id             String      @id @default(uuid())
  nf             String      @unique
  loja           String
  baseIcms       Decimal
  comissaoVenda  Decimal?    @map("comissao_venda")
  comissaoFrete  Decimal?    @map("comissao_frete")
  desconto       Decimal?
  liquidoReceber Decimal     @map("liquido_receber")
  status         VendaStatus @default(PENDENTE) // <-- NOVO CAMPO
  dataVenda      DateTime    @default(now())
  qtdParcelas    Int?        @map("qtd_parcelas")

  marketplaceId String
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id])
  pagamentos    Pagamento[]

  createdAt DateTime @default(now())

  @@map("vendas")
}

model Pagamento {
  id      String   @id @default(uuid())
  valor   Decimal
  data    DateTime
  nfVenda String   @map("nf_venda")

  // SUGESTÃO: Guarde isso para auditoria futura (opcional mas recomendado)
  comissaoRetida Decimal? @map("comissao_retida") @db.Decimal(10, 2)
  numeroParcela  Int?     @map("numero_parcela")

  // Relacionamento com Venda
  vendaId String
  venda   Venda  @relation(fields: [vendaId], references: [id])

  @@map("pagamentos")
}
